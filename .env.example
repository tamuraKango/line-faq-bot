# このファイルをコピーして .env を作り、値を入れてください（.env はコミットしない）

# --- LINE（Phase 1 から必須）---
# LINE Developers > チャネル基本設定 > チャネルシークレット
LINE_CHANNEL_SECRET=
# LINE Developers > Messaging API設定 > チャネルアクセストークン（長期）
LINE_CHANNEL_ACCESS_TOKEN=

# --- Claude（Phase 3 から使用）---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- WordPress（Phase 2 から使用）---
WP_BASE_URL=http://localhost:8080
# REST API の場所がサイトの URL と違うとき（WordPress.com など）だけ指定する。指定すると WP_BASE_URL より優先される
# 例: https://public-api.wordpress.com/wp/v2/sites/<サイト名>.wordpress.com
WP_API_URL=
# docker compose 用。ローカル専用なので、適当な長い文字列でよい
WP_DB_PASSWORD=
WP_DB_ROOT_PASSWORD=
# WordPress 管理画面（http://localhost:8080/wp-admin、ユーザー名 admin）のパスワード
WP_ADMIN_PASSWORD=

# --- bot ---
PORT=3000
# development のときだけ、受け取った質問本文をログに出す
NODE_ENV=development
